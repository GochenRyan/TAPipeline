# ------------------------------------------------------------
# OS junk
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini


# ------------------------------------------------------------
# Editor / IDE local files
# ------------------------------------------------------------
.vs/
.idea/

*.suo
*.user
*.userosscache
*.sln.docstates

# Keep shared VSCode config if the repo uses it.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# ------------------------------------------------------------
# Python cache
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ------------------------------------------------------------
# Python virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/


# ------------------------------------------------------------
# CMake local build files
# ------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# Keep compile_commands.json if your team wants it committed.
# Otherwise ignore it because it is usually machine-specific.
compile_commands.json


# ------------------------------------------------------------
# Common local build output folders
# ------------------------------------------------------------
/build/
/build-*/
/out/
/_artifacts/
/_Bin/
/_bin/


# ------------------------------------------------------------
# Visual Studio / MSVC build intermediate files
# ------------------------------------------------------------
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
x64/
x86/
Win32/
ARM64/

*.obj
*.pch
*.pdb
*.idb
*.ilk
*.ipdb
*.iobj
*.tlog
*.lastbuildstate
*.recipe
*.rsp
*.log


# ------------------------------------------------------------
# C++ generated import/export files
# ------------------------------------------------------------
*.exp

# Usually generated by building DLL/Maya plugins.
# Do not ignore *.mll / *.dll globally if this repo ships runnable plugins.
# Ignore libs only if they are generated locally.
*.lib


# ------------------------------------------------------------
# Maya crash / temporary files
# ------------------------------------------------------------
mayaCrashLog*
MayaCrashLog*
*.stackTrace
*.dmp
*.mdmp

*.tmp
*.bak
*.backup


# ------------------------------------------------------------
# Maya local user preferences
# Do not commit personal Maya preferences.
# Curated shelves/icons/modules should live in repo folders and stay tracked.
# ------------------------------------------------------------
prefs/
userPrefs.mel
windowPrefs.mel
pluginPrefs.mel


# ------------------------------------------------------------
# Local pipeline config
# Commit templates, ignore developer-local overrides.
# ------------------------------------------------------------
*.local.json
*.local.yaml
*.local.yml
*.local.toml

.env
.env.*
!.env.example


# ------------------------------------------------------------
# Local logs / temp outputs
# ------------------------------------------------------------
logs/
temp/
tmp/
.cache/
test_output/
test_outputs/


# ------------------------------------------------------------
# TAPipeline / Maya pip-installed third-party deps
# Managed by launch.bat via mayapy -m pip install -t.
# Keep the directory itself, ignore its contents.
# ------------------------------------------------------------
/toolkit/Maya2026/python/3.11/*
!/toolkit/Maya2026/python/3.11/.gitkeep


# ------------------------------------------------------------
# Perforce local files
# ------------------------------------------------------------
.p4tickets
.p4trust
.p4config.local
.p4ignore.local

# Keep .p4ignore if it defines team rules.
# Keep .p4config only if it is a safe shared config.
# Otherwise use .p4config.local.